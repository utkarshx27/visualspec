{
  "name": "visualspec",
  "version": "0.1.0",
  "description": "Structured, constraint-aware visual generation and deterministic layout for AI agents",
  "mcpName": "io.github.utkarshx27/visualspec",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "visualspec": "./bin/visualspec.js",
    "visual": "./bin/visual.js",
    "vspec": "./bin/vspec.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/utkarshx27/visualspec.git"
  },
  "homepage": "https://github.com/utkarshx27/visualspec#readme",
  "bugs": {
    "url": "https://github.com/utkarshx27/visualspec/issues"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "visual": "tsx src/cli/index.ts",
    "mcp": "tsx src/mcp/index.ts",
    "prepack": "npm run build"
  },
  "files": [
    "dist",
    "bin",
    "schemas",
    "platforms",
    "templates",
    "skills",
    "docs",
    "examples"
  ],
  "keywords": [
    "visual-generation",
    "ai-agents",
    "generative-ai",
    "deterministic-rendering",
    "design-system",
    "social-media",
    "mcp",
    "model-context-protocol"
  ],
  "author": "utkarshx27",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "sharp": "^0.33.5",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
