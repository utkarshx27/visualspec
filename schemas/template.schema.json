{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VisualTemplate",
  "description": "Structural layout template specification",
  "type": "object",
  "required": ["id", "slots", "layout"],
  "properties": {
    "id": { "type": "string" },
    "version": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "slots": {
      "type": "object",
      "properties": {
        "required": {
          "type": "array",
          "items": { "type": "string" }
        },
        "optional": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "region": { "type": "string" },
          "relation": { "type": "string" },
          "alignment": { "type": "string" },
          "prominence": { "type": "number" }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
